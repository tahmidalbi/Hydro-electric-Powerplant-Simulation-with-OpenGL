.PHONY : src/objects/WaterWheel.i

# target to preprocess a source file
src/objects/WaterWheel.cpp.i:
	$(MAKE) $(MAKESILENT) -f CMakeFiles\confluence.dir\build.make CMakeFiles/confluence.dir/src/objects/WaterWheel.cpp.i
.PHONY : src/objects/WaterWheel.cpp.i

src/objects/WaterWheel.s: src/objects/WaterWheel.cpp.s
.PHONY : src/objects/WaterWheel.s

# target to generate assembly for a file
src/objects/WaterWheel.cpp.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles\confluence.dir\build.make CMakeFiles/confluence.dir/src/objects/WaterWheel.cpp.s
.PHONY : src/objects/WaterWheel.cpp.s

